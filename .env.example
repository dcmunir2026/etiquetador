# === DB ===
# SQLite (default si DATABASE_URL no está, o si empieza por file:)
# DATABASE_URL=file:../../packages/db/etiquetador.db

# Postgres (docker compose up -d primero, luego esta URL).
# Credenciales definidas en docker-compose.yml (etiquetador / etiquetador_dev).
DATABASE_URL=postgres://etiquetador:etiquetador_dev@localhost:5432/etiquetador

# === AUTH (Auth.js v5) ===
# AUTH_SECRET=...
