# syntax=docker/dockerfile:1.7
#
# Build the etiquetador-web image for GHCR.
#
# Stages:
#   deps   — populate the pnpm store and node_modules for the web app
#   build  — run `next build` (produces .next/standalone, .next/static)
#   runner — minimal runtime image: standalone server + static + public
#
# Build context is the repo root so pnpm can resolve workspace packages.
# `.dockerignore` at the repo root excludes node_modules, .next, .env, etc.

############################
# 1. deps
############################
FROM node:22-alpine AS deps
WORKDIR /repo

# Honour package.json's `packageManager: pnpm@9.0.0`.
RUN corepack enable \
  && corepack prepare pnpm@9.0.0 --activate

# Copy ONLY files that affect the dependency graph so the layer is reusable.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json         ./apps/web/package.json
COPY apps/web/.npmrc.build         ./apps/web/.npmrc
COPY packages/shared/package.json  ./packages/shared/package.json
COPY packages/ui/package.json      ./packages/ui/package.json
# packages/db is intentionally NOT copied — apps/web has its own db mirror
# at apps/web/src/db/{client.ts,schema.ts} (see HANDOFF.md §4) and
# `drizzle-kit` is dev-only.

# `--filter @etiquetador/web...` installs web plus its workspace deps
# (shared, ui) without dragging in packages/db or any other package.
#
# The COPY above swaps in `.npmrc.build` which sets `node-linker=hoisted`
# so the install produces a flat node_modules tree at apps/web/node_modules.
# This is required so the Next.js standalone output's symlinks resolve
# correctly when we COPY the tree into the runner stage — pnpm's default
# (isolated) layout creates per-package symlinks pointing to the host's
# pnpm store, which does not exist inside the container. The dev workflow
# is unaffected: it uses the default pnpm layout from the project's own
# .npmrc (none today), not this temporary file.
RUN pnpm install --frozen-lockfile \
    --filter @etiquetador/web...


############################
# 2. build
############################
FROM node:22-alpine AS build
WORKDIR /repo

RUN corepack enable \
  && corepack prepare pnpm@9.0.0 --activate

# Copy the populated hoisted tree from the deps stage.
#
# We need BOTH:
#   1. /repo/apps/web/node_modules — Next's hoisted deps (the runtime tree).
#   2. /repo/node_modules            — pnpm's virtual store + shared workspace
#                                      deps. The `.bin/next` shim pnpm
#                                      generated in deps hardcodes paths
#                                      like /repo/node_modules/.pnpm/next...,
#                                      so omitting the store would break
#                                      `next build` even though the binary
#                                      itself lives under apps/web/node_modules.
#
# Layer-cache note: this COPY has to happen even with `--shamefully-hoist`
# (which hoists everything into apps/web/node_modules) because the shims
# were emitted by pnpm before hoisting took effect and still reference the
# virtual store.
COPY --from=deps /repo/apps/web/node_modules /repo/apps/web/node_modules
COPY --from=deps /repo/node_modules          /repo/node_modules

# Copy the rest of the source tree (filtered by .dockerignore).
COPY apps ./apps
COPY packages ./packages
COPY tsconfig.base.json ./

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Invoke `next` directly via the hoisted `.bin/` shim. The shim was
# generated by pnpm in the deps stage and points at the virtual store
# at /repo/node_modules/.pnpm/...; the COPYs above carry that store
# over to the build stage, so the shim resolves correctly.
RUN cd /repo/apps/web && ./node_modules/.bin/next build


############################
# 3. runner
############################
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Next's standalone server honours HOSTNAME — without 0.0.0.0 it binds to
# localhost only and the container is unreachable from outside.
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

# Non-root runtime user.
RUN addgroup --system --gid 1001 nodejs \
  && adduser  --system --uid 1001 --ingroup nodejs nextjs

# The standalone tree includes the server entrypoint and traces the runtime
# node_modules it needs. `.next/static` and `public/` are NOT included — Next
# expects them at the workspace paths below.
#
# IMPORTANT: the server.js runs with cwd=/app, and `next.config.mjs` has
# `distDir: .next`, so at runtime Next resolves the static dir to
# `/app/.next/static` (NOT `/app/apps/web/.next/static`). The previous
# build copied the static files to the latter path, which made Next fall
# back to running the middleware on every chunk request and return 307s
# to /login instead of the JS bytes.
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/static   ./.next/static
# public/ is served from the workspace root in dev; in standalone the
# server expects /app/public. The build artefact has no public/ folder
# for this app (no static assets), so we just create the empty directory.
RUN mkdir -p ./public

# The traced node_modules shipped by Next standalone include symlinks to
# pnpm's virtual store at /repo/node_modules/.pnpm/... (the build stage
# ran with `node-linker=hoisted` but the symlinks were emitted before
# hoisting). Without copying the store into the runner, `require('next')`
# at boot throws `Cannot find module 'next'` even though `/app/node_modules/next`
# exists — it's a dangling symlink.
#
# Each traced symlink is of the form:
#   /app/node_modules/<pkg> -> ../../../node_modules/.pnpm/<pkg>@ver.../node_modules/<pkg>
# which resolves to /node_modules/.pnpm/<pkg>@ver.../node_modules/<pkg>
# (three `..` from /app/node_modules/<pkg>/ → /).
# So we copy the pnpm store to /node_modules/.pnpm in the runner stage.
COPY --from=build --chown=nextjs:nodejs /repo/node_modules/.pnpm /node_modules/.pnpm

# Migration runner script. The `migrate` service in docker-compose.prod.yml
# invokes this once per deploy. Migrations themselves are NOT bundled by
# Next's standalone output, so we copy them (and the script) explicitly.
#
# Both `migrations/` and `scripts/` may be empty on the very first deploy
# (before `pnpm db:generate` has produced any SQL). The runner script
# detects that and exits 1 with a clear message — the docker-compose `migrate`
# service will then fail and the operator gets actionable output.
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/scripts/migrate-runner.cjs ./scripts/migrate-runner.cjs
RUN mkdir -p ./migrations
# Copy the generated Drizzle SQL + meta journal. If the folder is empty
# (e.g. on a fresh checkout before `pnpm db:generate` has run), the COPY
# succeeds but no files land — `migrate-runner.cjs` exits 1 with a clear
# error in that case.
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/migrations/ ./migrations/

# Make the migrate script executable in case the COPY preserved umask 644.
RUN chmod +x ./scripts/migrate-runner.cjs

USER nextjs
EXPOSE 3000

CMD ["node", "server.js"]