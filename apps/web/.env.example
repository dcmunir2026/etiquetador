# Local development env
# For SQLite (current dev), point to the .db file under packages/db.
DATABASE_URL=file:../../packages/db/etiquetador.db

# Auth.js v5
AUTH_SECRET=replace-with-32-bytes-of-randomness  # `openssl rand -base64 32`
AUTH_TRUST_HOST=true                              # required when behind a proxy / for non-HTTPS dev

# Legacy alias kept for tools that read it.
NEXTAUTH_URL=http://localhost:3000
