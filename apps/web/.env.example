# Local development env

# SQLite for dev (no Docker needed). PostgreSQL is the production target.
DATABASE_URL=file:../../packages/db/etiquetador.db

# Auth.js v5. Generate the secret with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-bytes-of-randomness
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
