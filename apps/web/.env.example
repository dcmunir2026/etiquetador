# Local development env

# PostgreSQL — docker compose (etiquetador-postgres on 5433).
DATABASE_URL=postgres://etiquetador:etiquetador_dev@localhost:5433/etiquetador

# Auth.js v5. Generate the secret with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-bytes-of-randomness
# In dev make sure this matches the port you actually run `next dev` on,
# because the value is used to build the magic-link URLs in invitation
# emails. (Production: your real domain, HTTPS.)
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Outgoing mail — Resend. Leaving RESEND_API_KEY empty falls back to the
# server console (the magic-link URL is logged instead of emailed). In
# production, set both: a verified domain in MAIL_FROM and the API key.
RESEND_API_KEY=
MAIL_FROM=Etiquetador <onboarding@resend.dev>
